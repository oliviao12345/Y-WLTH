{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": { "entrypoint": "proxy.ts" },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
