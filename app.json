{
  "expo": {
    "name": "Y-WLTH",
    "slug": "ywlth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ywlth",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.ywlth.app",
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061552",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#05092B"
  }
}